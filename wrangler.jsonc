/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "abm-tg-git-updater",
	"main": "src/index.ts",
	"compatibility_date": "2025-02-14",
	"observability": {
		"enabled": true
	},
	"vars": {
		"TELEGRAM_ORG_CHANNELS": "[{\"org\":\"Android-Boot-Manager\",\"chatId\":\"CHANGE_ME\"},{\"org\":\"ABM-Community-Ports\",\"chatId\":\"CHANGE_ME\"}]",
		"ENABLED_EVENTS": "PUSH,PULL_REQUEST,CI_FAILURE"
	}
}
